# Значения по умолчанию заданы в коде, env их переопределяет
# Путь к yaml-конфигу задаётся флагом --config-file, по умолчанию читается configs/dev.yaml

# Необязательные переопределения

# PostgreSQL -- используется в compose
DB_PORT=5432
POSTGRES_USER=patreon
POSTGRES_PASSWORD=database_password
POSTGRES_DB=patreon
MIGRATE_DATABASE_URL=pgx5://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:${DB_PORT}/${POSTGRES_DB}?sslmode=disable

# S3 - ключи пользователя app из configs/s3.json, должны с ними совпадать
S3_ACCESS_KEY=s3_access_key
S3_SECRET_KEY=s3_secret_key

# JWT
JWT_SECRET=your-super-secret-string-with-at-least-32-symbols

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Помимо приложения используется еще и в compose
HTTP_PORT=8080
