{
  "openapi": "3.0.3",
  "info": {
    "title": "Usage Limit Reached API",
    "description": "Просмотр собственного профиля.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "paths": {
    "/profile/me": {
      "get": {
        "summary": "Профиль текущего пользователя",
        "operationId": "getMyProfile",
        "security": [
          {
            "CookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Профиль и посты пользователя.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                },
                "example": {
                  "user": {
                    "id": "7c9e6679-7425-40de-944b-e07fc1f90ae7",
                    "username": "anna_k",
                    "nickname": "Анна",
                    "email": "anna@example.com",
                    "avatar_key": "",
                    "created_at": "2026-09-01T09:14:32Z"
                  },
                  "author": {
                    "bio": "Пишу про акварель и городские скетчи",
                    "category": "Искусство"
                  },
                  "posts": [
                    {
                      "id": "3f2b8c1e-5d4a-4e7b-9a10-6c8d2f1b0e45",
                      "title": "Как я начала рисовать акварелью",
                      "body": "Первые пробы были неудачными, но...",
                      "status": "published",
                      "published_at": "2026-09-02T18:40:05Z"
                    },
                    {
                      "id": "b1a4d9f0-2c63-4f8e-8d57-0e9a7c3b5d12",
                      "title": "Черновик про скетчбуки",
                      "body": "Заметки к будущему посту",
                      "status": "draft"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Не авторизован.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "unauthorized"
                }
              }
            }
          },
          "500": {
            "description": "Внутренняя ошибка сервера.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "internal error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "CookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "token"
      }
    },
    "schemas": {
      "Profile": {
        "type": "object",
        "required": [
          "user",
          "posts"
        ],
        "properties": {
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "author": {
            "$ref": "#/components/schemas/Author"
          },
          "posts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Post"
            }
          }
        }
      },
      "User": {
        "type": "object",
        "required": [
          "id",
          "username",
          "nickname",
          "email",
          "avatar_key",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "username": {
            "type": "string"
          },
          "nickname": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "avatar_key": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Author": {
        "description": "Есть только у пользователей с профилем автора.",
        "type": "object",
        "required": [
          "bio",
          "category"
        ],
        "properties": {
          "bio": {
            "type": "string"
          },
          "category": {
            "type": "string"
          }
        }
      },
      "Post": {
        "type": "object",
        "required": [
          "id",
          "title",
          "body",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "published"
            ]
          },
          "published_at": {
            "type": "string",
            "format": "date-time",
            "description": "Только у опубликованных постов."
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      }
    }
  }
}
